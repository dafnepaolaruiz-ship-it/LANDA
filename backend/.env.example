# Variables del backend. Copia este archivo a ".env" (que NO se sube a git) y ajusta los valores.
# Los valores de abajo son ilustrativos y NO son secretos. Los comentarios van en líneas aparte.

# development | production
ENVIRONMENT=development

# Local: SQLite. Producción: PostgreSQL administrado con cifrado en tránsito, por ejemplo:
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/landa?sslmode=require
DATABASE_URL=sqlite:///./landa_dev.db

# Solo desarrollo. En producción las tablas se crean con "alembic upgrade head".
AUTO_CREATE_TABLES=false

# true: FastAPI sirve ../frontend (local o despliegue único). false: frontend aparte (Vercel).
SERVE_FRONTEND=true

# Mínimo 32 caracteres aleatorios. Generar con:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
FORM_SIGNING_SECRET=cambia-esto-por-un-valor-aleatorio-largo-de-48-caracteres

# Orígenes del frontend autorizados (separados por coma). Producción: https://tu-dominio.com
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Dejar vacío = automático (true en producción). En producción no puede ser false.
COOKIE_SECURE=

# Número de proxies de confianza delante de la app (ver docs/despliegue.md). 0 = ninguno.
TRUSTED_PROXY_COUNT=0

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Límite configurable por registro. NO es el aforo oficial del evento.
MAX_ATTENDEES=10

# Antispam opcional (Cloudflare Turnstile). Vacío = desactivado (quedan honeypot + límites).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Poner true SOLO cuando la organizadora confirme fecha, horario y datos del evento.
EVENT_DETAILS_CONFIRMED=false

# Datos legales REALES (no inventar). Vacíos = el aviso muestra "POR CONFIGURAR".
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTROLLER_ADDRESS=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTACT_PHONE=449 348 1867
PRIVACY_RETENTION_TEXT=
PRIVACY_PROVIDERS_TEXT=
PRIVACY_TRANSFERS_TEXT=
